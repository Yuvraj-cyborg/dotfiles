// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "icon_theme": "Catppuccin Mocha",
  "disable_ai": true,
  "language_models": {
    "openai_compatible": {
      "opanai": {
        "api_url": "http://localhost:3000/v1",
        "available_models": [
          {
            "name": "gpt-occ",
            "display_name": null,
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true
            }
          }
        ]
      },
      "gpt-120": {
        "api_url": "http://localhost:3000/v1/chat/completions",
        "available_models": [
          {
            "name": "gpt-120b-oss",
            "display_name": null,
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true
            }
          }
        ]
      },
      "gpt-120b": {
        "api_url": "http://localhost:3000/v1",
        "available_models": [
          {
            "name": "gpt-120b",
            "display_name": null,
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true
            }
          }
        ]
      },
      "vertex-120b": {
        "api_url": "http://localhost:3000/v1",
        "available_models": [
          {
            "name": "gpt-120b-oss",
            "display_name": null,
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow"
        }
      }
    },
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-2.5-pro"
    },
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.5"
    }
  },
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Panda",
    "dark": "Panda"
  }
}
